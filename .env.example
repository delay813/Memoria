# ============================================================
# 环境配置模板: 复制为 .env 并填入你的 API Key
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
# ============================================================

# 百炼平台 API Key(必填)
# 也可使用 DASHSCOPE_API_KEY(优先级高于 API_KEY)
API_KEY=

# 对话主模型
CHAT_MODEL=qwen-max

# 文档向量化模型
EM_MODEL=text-embedding-v1

# RAG 重排模型
RERANK_MODEL=gte-rerank-v2

# 便宜模型(好感度/心情/读心/遗忘等辅助判断)
FAVOR_MODEL=qwen-turbo
FORGET_MODEL=qwen-turbo
COGNITION_MODEL=qwen-turbo
